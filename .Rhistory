# Chunk 11: Helper function
## ---  Sensitivity Analysis Function ---
run_sensitivity <- function(
base_model,
target_vars,
data,
period_label,
priors,
...
) {
model_results_list <- list()
for (var in target_vars) {
message(
paste0(
"Running sensitivity analysis for: ",
var,
" (",
period_label,
")"
)
)
new_formula <- update.formula(
formula(base_model),
as.formula(paste(var, "~ ."))
)
mod <- update(
base_model,
formula = new_formula,
newdata = data,
prior = priors,
...
)
saveRDS(
mod,
file = here(
"outputs/models",
paste0("m_", var, "_", period_label, ".rds")
)
)
res <- broom.mixed::tidy(
mod,
effects = "fixed",
conf.int = TRUE
) %>%
mutate(model_label = var)
model_results_list[[var]] <- res
}
bind_rows(model_results_list)
}
## --- 2. Master Helper Function ---
process_model_group <- function(base_model, target_vars, data, label, group_name, priors, ...) {
# --- A. Standard Density PP-Check ---
pp_dens <- pp_check(base_model, ndraws = 100) +
labs(
x = "Temperature (°C)",
y = "Probability Density",
title = paste("Distribution Check:", group_name),
subtitle = "Observed data (y) vs. 100 model simulations (y_rep)"
) +
theme_bw() +
theme(axis.title = element_text(face = "bold"), plot.title = element_text(hjust = 0.5))
ggsave(here("outputs", "figures", paste0("pp_check_", label, ".png")), pp_dens, width = 7, height = 5)
# --- B. LOO-PIT QQ-Plot (Calibration Check) ---
# Requires library(loo)
pp_qq <- pp_check(base_model, type = "loo_pit_qq") +
labs(
title = paste("Calibration Check (LOO-PIT):", group_name),
subtitle = "Assessing predictive distribution calibration (Uniformity)",
x = "Theoretical Uniform Quantiles",
y = "Sample Data Quantiles"
) +
theme_bw() +
theme(axis.title = element_text(face = "bold"), plot.title = element_text(hjust = 0.5))
ggsave(here("outputs", "figures", paste0("pp_qq_", label, ".png")), pp_qq, width = 7, height = 5)
# --- C. Run Sensitivity Loop ---
all_results <- run_sensitivity(
base_model = base_model,
target_vars = target_vars,
data = data,
period_label = label,
priors = priors,
...
)
# --- D. Extract Main Model Results (Fixed + Hyperparameters) ---
# Including 'ran_pars' ensures we get sd(Intercept) for Date, Wall distance, etc.
base_res_fixed <- broom.mixed::tidy(base_model, effects = "fixed", conf.int = TRUE) %>%
mutate(model_label = "Base (95th)")
# We return a list containing the full tidy results for tables AND the combined results for plots
return(list(
plot_data = bind_rows(all_results, base_res_fixed),
full_table = broom.mixed::tidy(base_model, effects = c("fixed", "ran_pars"), conf.int = TRUE)
))
}
# Chunk 12: Define priors
# Define a weakly informative prior for all fixed and random effects
# Monthly - day
make_monthly_priors <- function(shield_sd = 1) {
c(
set_prior(
paste0("normal(0, ", shield_sd, ")"),
class = "b",
coef = "midshield_binomial"
),
set_prior(
"normal(0, 1)",
class = "sd",
group = "div"
),
set_prior(
"normal(0, 1)",
class = "sd",
group = "treatment"
),
set_prior(
"normal(0, 1)",
class = "sd",
group = "dist_wall"
),
set_prior(
"normal(0, 2)",
class = "sigma"
)
)
}
# Monthly - Night
make_monthly_night_priors <- function(
shield_sd = 2,
group_sd = 0.5,
sigma_sd = 1
) {
c(
set_prior(
paste0("normal(0, ", shield_sd, ")"),
class = "b",
coef = "midshield_binomial"
),
set_prior(
paste0("normal(0, ", group_sd, ")"),
class = "sd",
group = "div"
),
set_prior(
paste0("normal(0, ", group_sd, ")"),
class = "sd",
group = "treatment"
),
set_prior(
paste0("normal(0, ", group_sd, ")"),
class = "sd",
group = "dist_wall"
),
set_prior(
paste0("normal(0, ", sigma_sd, ")"),
class = "sigma"
)
)
}
# Daily levels
make_daily_day_priors <- function(shield_sd = 1) {
c(
# Middle-shield effect
set_prior(
paste0("normal(0, ", shield_sd, ")"),
class = "b",
coef = "midshield_binomial"
),
# Weather and interaction effects: predictors are standardized
set_prior(
"normal(0, 1)",
class = "b",
coef = "rad_scaled"
),
set_prior(
"normal(0, 1)",
class = "b",
coef = "wind_scaled"
),
set_prior(
"normal(0, 1)",
class = "b",
coef = "midshield_binomial:rad_scaled"
),
set_prior(
"normal(0, 1)",
class = "b",
coef = "midshield_binomial:wind_scaled"
),
# Persistent probe-to-probe variation
set_prior(
"normal(0, 1)",
class = "sd",
group = "probe"
),
# Experimental-design grouping terms
set_prior(
"normal(0, 1)",
class = "sd",
group = "div"
),
set_prior(
"normal(0, 1)",
class = "sd",
group = "treatment"
),
set_prior(
"normal(0, 1)",
class = "sd",
group = "dist_wall"
),
# Day-to-day variation may plausibly be larger
set_prior(
"normal(0, 2)",
class = "sd",
group = "Date"
),
# Residual variation
set_prior(
"normal(0, 2)",
class = "sigma"
)
)
}
# Daily - Night
make_daily_night_priors <- function(shield_sd = 2) {
c(
# Middle-shield main effect
set_prior(
paste0("normal(0, ", shield_sd, ")"),
class = "b",
coef = "midshield_binomial"
),
# Wind main effect
set_prior(
"normal(0, 1)",
class = "b",
coef = "wind_scaled"
),
# Shield-by-wind interaction
set_prior(
"normal(0, 1)",
class = "b",
coef = "midshield_binomial:wind_scaled"
),
# Probe-level variation
set_prior(
"normal(0, 1)",
class = "sd",
group = "probe"
),
# Other grouping variables
set_prior(
"normal(0, 1)",
class = "sd",
group = "div"
),
set_prior(
"normal(0, 1)",
class = "sd",
group = "treatment"
),
set_prior(
"normal(0, 1)",
class = "sd",
group = "dist_wall"
),
# Date-level variation
set_prior(
"normal(0, 2)",
class = "sd",
group = "Date"
),
# Residual variation
set_prior(
"normal(0, 2)",
class = "sigma"
)
)
}
