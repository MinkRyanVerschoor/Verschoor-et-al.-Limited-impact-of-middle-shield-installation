# --- 2. Posterior Expectations for Night Model ---
night_pred <- microclimate_shield_total_night %>%
distinct(midshield_binomial) %>%
add_epred_draws(m_night_05, re_formula = NA) %>%
mutate(
midshield = factor(midshield_binomial, levels = c(1, 0), labels = c("present", "absent"))
)
Plot_B_model <- ggplot(night_pred, aes(x = midshield, y = .epred, fill = midshield, color = midshield)) +
stat_halfeye(
point_interval = median_hdi,
.width = c(0.80, 0.95),
slab_alpha = 0.4,
side = "left",
scale = 0.6,
justification = 1.15
) +
coord_cartesian(ylim = c(12.5, 15.2)) +
labs(
x = "Shield Configuration",
y = "Min Temp (°C) at 1 cm (23:00 - 05:00)"
) +
scale_x_discrete(labels = c("present" = "Present", "absent" = "Absent")) +
scale_color_manual(values = shield_colors) +
scale_fill_manual(values = shield_colors) +
theme_minimal() +
theme(
text = element_text(family = "Arial", size = 16),
axis.title.y = element_text(family = "Arial", size = 16, margin = margin(r = 10)),
axis.title.x = element_text(family = "Arial", size = 16),
axis.text.x = element_text(family = "Arial", size = 16),
axis.text.y = element_text(family = "Arial", size = 16),
legend.position = "none",
panel.grid.major.x = element_blank()
)
# ------- Combine and Adjust Layout -------- #
figure_2 <- (Plot_A_model + Plot_B_model) +
plot_annotation(tag_levels = 'A') &
theme(plot.tag = element_text(size = 20, face = "bold", family = "Arial"))
figure_2
# Save to file
ggsave(file.path("outputs/figures", "figure_2.jpg"), figure_2, width = 24, height = 12, dpi = 300)
priors_daily <- c(
prior(normal(0, 0.5), class = "b", coef = "midshield_binomial"),
prior(normal(0, 1), class = "b", coef = "rad_scaled"),
prior(normal(0, 1), class = "b", coef = "wind_scaled"),
prior(normal(0, 1), class = "b", coef = "midshield_binomial:rad_scaled"),
prior(normal(0, 1), class = "b", coef = "midshield_binomial:wind_scaled"),
prior(normal(0, 1), class = "sd"),
prior(normal(0, 2), class = "sigma")
)
pp_check(m_day_95)
pp_check(m_night_95)
pp_check(m_night_05)
